# Copy to deploy/.env and fill in. deploy/.env is git-ignored; it holds secrets.

# Pages are served at https://<page>.PAGES_DOMAIN. DNS: an A record for PAGES_DOMAIN and one for *.PAGES_DOMAIN.
PAGES_DOMAIN=sites.example.com
# The admin. "admin" is a reserved page name, so admin.PAGES_DOMAIN needs no extra DNS record.
ADMIN_HOST=admin.sites.example.com
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=you@example.com

# Who may log in: github:<numeric user id> or google:<sub>, comma-separated.
ALLOWLIST=github:12345678
# At least 32 bytes; generate with: openssl rand -hex 32
SESSION_KEY=

# At least one login provider. Callback URL: https://ADMIN_HOST/auth/github/callback (or /auth/google/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: host:port of a clamd daemon to scan uploads.
CLAMD_ADDR=
